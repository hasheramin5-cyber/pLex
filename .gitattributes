# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf diff=python
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Binary files (prevent any line ending conversion or corruption)
*.pdf binary
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
